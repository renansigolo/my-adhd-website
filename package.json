    "next": "16.2.4",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-hot-toast": "2.6.0",
    "sharp": "0.35.3",
