{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "jsdoc": true,
  "sortImports": {
    "groups": [
      "type",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css"
  },
  "ignorePatterns": ["CHANGELOG.md"]
}
